# ============================================
# StartupX AI - Environment Variables Template
# ============================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================

# Provider credentials are required only for their live features, not unit tests/build.
# Copying these placeholders does not configure a provider.
# --- ANTHROPIC (REQUIRED for analysis) ---
# Get from: https://console.anthropic.com/
# Used server-side ONLY in API routes - never exposed to browser
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- SUPABASE (REQUIRED for auth / DB persistence) ---
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key - SERVER SIDE ONLY, never expose to client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional model override; omit to use the existing application default.
# ANTHROPIC_MODEL=

# --- LEGACY APP CONFIG (not currently read by application source) ---
NEXT_PUBLIC_APP_URL=https://startupxai.in
# For local dev use: http://localhost:3000

# --- RAZORPAY (REQUIRED for paid plans) ---
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- SECURITY ---
# Random string for IP hashing (generate with: openssl rand -hex 32)
IP_HASH_SALT=your-random-salt-string-here-min-32-chars

# --- NODE ENV ---
NODE_ENV=development
# Set to 'production' on deployment

# ============================================
# NOTES:
# - All NEXT_PUBLIC_ vars are exposed to the browser
# - All other vars are server-side only
# - Rotate ANTHROPIC_API_KEY if compromised
# - Never share SUPABASE_SERVICE_ROLE_KEY
# ============================================
# Optional Phase 3 GitHub App. Restore securely; source analysis needs no model key.
# Read-only repository Metadata/Contents; OAuth callback UI bridge is deployment-specific.
LAUNCHGATE_GITHUB_APP_ID=
LAUNCHGATE_GITHUB_CLIENT_ID=
LAUNCHGATE_GITHUB_CLIENT_SECRET=
LAUNCHGATE_GITHUB_PRIVATE_KEY=
LAUNCHGATE_GITHUB_WEBHOOK_SECRET=
LAUNCHGATE_GITHUB_REDIRECT_URI=
# Optional Phase 4 operator-managed JSON array; never expose as NEXT_PUBLIC.
# Entries: projectId, organizationId, credentialReference (UUIDs), accountId
# (team_*), providerProjectId (prj_*), token (team-owner credential).
# No provider credentials are required for CI or synthetic tests.
LAUNCHGATE_VERCEL_CONNECTIONS=
